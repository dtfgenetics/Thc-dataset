{
  "schemaVersion":"1.0.0",
  "purpose":"Coverage targets for turning the diagnostic taxonomy into a defensible Cannabis image/video dataset.",
  "globalTargets":{
    "minimumConfirmedCannabisImagesPerCoreClass":50,
    "preferredConfirmedCannabisImagesPerCoreClass":150,
    "minimumIndependentPlantsPerCoreClass":10,
    "minimumIndependentSourceGroupsPerCoreClass":3,
    "minimumHealthyCannabisControls":300,
    "minimumLookAlikeNegativesPerCoreClass":25,
    "videoTargetPerCoreClass":10
  },
  "priorityTiers":{
    "P0":"High-frequency or high-consequence diagnoses required for first dependable app release.",
    "P1":"Important differential diagnoses needed to reduce false positives.",
    "P2":"Rare, laboratory-dependent, normal-development, or context classes useful for abstention and advanced diagnosis."
  },
  "classes":[
    {"id":"nut-def-n","priority":"P0","needs":["confirmed Cannabis photo series","healthy matched controls","root-zone/tissue metadata"]},
    {"id":"nut-def-p","priority":"P1","needs":["panel-level scientific crops","independent cultivar examples","look-alike negatives"]},
    {"id":"nut-def-ca","priority":"P0","needs":["vegetative and flowering examples","root-zone metadata","mite and K/Mg negatives"]},
    {"id":"nut-def-fe","priority":"P1","needs":["upper-canopy serial images","symptom-negative analytical examples","Mn/Zn/S negatives"]},
    {"id":"nut-def-zn","priority":"P1","needs":["mechanism-reviewed examples","P interaction metadata","panel crops"]},
    {"id":"nut-def-s","priority":"P1","needs":["vegetative and flowering series","N/senescence negatives"]},
    {"id":"nut-def-mn","priority":"P1","needs":["upper-canopy examples","symptom-negative analytical controls"]},
    {"id":"nut-def-cu","priority":"P2","needs":["independent Cannabis examples","mite/B deficiency negatives"]},
    {"id":"nut-def-mg","priority":"P0","needs":["older-leaf and flowering series","K/N/senescence negatives"]},
    {"id":"nut-def-k","priority":"P0","needs":["fan-leaf and sugar-leaf series","salinity/B toxicity negatives"]},
    {"id":"nut-tox-n","priority":"P0","needs":["total-N and ammonium-form separated labels","root imagery","EC context"]},
    {"id":"nut-tox-b","priority":"P1","needs":["confirmed exposure series","K/salinity/contact negatives"]},
    {"id":"mite-spider","priority":"P0","needs":["organism macros","early stippling","webbing progression"]},
    {"id":"mite-hemp-russet","priority":"P0","needs":["microscope-confirmed plant pairs","canopy damage series"]},
    {"id":"mite-broad","priority":"P0","needs":["microscope-confirmed cannabis damage","fresh-growth macros"]},
    {"id":"insect-thrips","priority":"P0","needs":["organism-plus-damage pairs","silver-scar macro images"]},
    {"id":"fungal-pm","priority":"P0","needs":["early through advanced Cannabis colonies","residue negatives"]},
    {"id":"fungal-botrytis-bud-rot","priority":"P0","needs":["external and internal flower views","lab-confirmed independent cases","Fusarium/Penicillium negatives"]},
    {"id":"bacterial-xanthomonas-leaf-spot","priority":"P2","needs":["lab-confirmed Cannabis images","fungal/contact lesion negatives"]},
    {"id":"root-pythium","priority":"P0","needs":["cleaned-root images","lab-confirmed cases","hypoxia/Fusarium negatives"]},
    {"id":"virus-bctv","priority":"P2","needs":["PCR-confirmed image series","mite/PGR negatives"]},
    {"id":"phytoplasma-hemp-witches-broom","priority":"P2","needs":["molecularly confirmed cases","BCTV/Spiroplasma separation"]},
    {"id":"viroid-hplvd","priority":"P0","needs":["PCR-linked whole-plant series","healthy same-cultivar controls","rooting and flower views"]},
    {"id":"gen-variegation","priority":"P2","needs":["lineage-mapped serial examples","pathogen-negative evidence"]},
    {"id":"env-heat","priority":"P1","needs":["measured PPFD/temperature-linked examples","mite/water negatives"]},
    {"id":"water-over","priority":"P0","needs":["measured saturation series","cleaned roots","pathogen-negative cases"]},
    {"id":"root-ph-extreme","priority":"P1","needs":["calibrated root-zone pH series","media-specific labels"]},
    {"id":"normal-sex-expression","priority":"P0","needs":["male/female/co-sexual macro sets","multi-node flowering views"]},
    {"id":"normal-fade","priority":"P0","needs":["healthy same-cultivar flowering timelines","nutrient/pathogen negatives"]},
    {"id":"pest-cannabis-aphid","priority":"P0","needs":["species-confirmed Cannabis colonies","stem and underside views"]},
    {"id":"pest-rice-root-aphid","priority":"P1","needs":["root-associated organism images","fungus-gnat controls"]},
    {"id":"pest-fungus-gnats","priority":"P1","needs":["larva/adult/root-zone pairs","root-disease controls"]},
    {"id":"root-fusarium-crown-rot","priority":"P0","needs":["crown cross-sections","lab-confirmed roots","Pythium controls"]},
    {"id":"stress-salinity-high-ec","priority":"P0","needs":["measured EC series","ion/source metadata","K/N-toxicity negatives"]},
    {"id":"stress-drought-water-deficit","priority":"P0","needs":["measured moisture series","recovery sequences","salinity/root-disease negatives"]}
  ]
}
