{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/thc-grow-doc/inference-decision-log-0.3.0.json",
  "title": "THC Plant Diagnostic inference decision log",
  "type": "object",
  "additionalProperties": true,
  "required": ["analysisId", "caseId", "mediaIds", "modelVersions", "taxonomyVersion", "evidenceIndexVersion", "qualityAndOod", "pass1Candidates", "pass1FeatureEvidence", "pass2EvidenceIds", "hardDifferentialResults", "contradictionFlags", "pass3VerifierOutcomes", "openSetUnknownScore", "rawFinalCandidate", "responsePolicyApplied", "finalLabelAndConfidence", "humanReviewStatus"],
  "properties": {
    "analysisId": {"type": "string"},
    "caseId": {"type": "string"},
    "mediaIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "modelVersions": {"type": "object", "additionalProperties": {"type": "string"}},
    "taxonomyVersion": {"type": "string"},
    "evidenceIndexVersion": {"type": "string"},
    "qualityAndOod": {"type": "object"},
    "organStagePredictions": {"type": "object"},
    "pass1Candidates": {"type": "array", "items": {"type": "object"}},
    "pass1FeatureEvidence": {"type": "object"},
    "pass2RetrievalNeighbors": {"type": "array", "items": {"type": "object"}},
    "pass2EvidenceIds": {"type": "array", "items": {"type": "string"}},
    "hardDifferentialResults": {"type": "array", "items": {"type": "object"}},
    "contradictionFlags": {"type": "array", "items": {"type": "object"}},
    "pass3VerifierOutcomes": {"type": "array", "items": {"type": "object"}},
    "openSetUnknownScore": {"type": "number", "minimum": 0, "maximum": 1},
    "rawFinalCandidate": {"type": "object"},
    "responsePolicyApplied": {"type": "object"},
    "finalLabelAndConfidence": {"type": "object"},
    "finalAlternatives": {"type": "array", "items": {"type": "object"}},
    "interventionEvidenceIds": {"type": "array", "items": {"type": "string"}},
    "followupInformationGain": {"type": ["object", "null"]},
    "escalationTrigger": {"type": ["object", "null"]},
    "humanReviewStatus": {"enum": ["not-reviewed", "pending", "reviewed-confirmed", "reviewed-revised", "unresolved"]},
    "humanFinalLabels": {"type": "array", "items": {"type": "object"}},
    "supersedesAnalysisId": {"type": ["string", "null"]}
  }
}
