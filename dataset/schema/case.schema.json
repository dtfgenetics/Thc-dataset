{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/thc-grow-doc/case-1.0.0.json",
  "title": "THC Grow Doc diagnostic case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "taskType", "createdAt", "plant", "evidenceMediaIds", "context", "observations", "predictions", "verification", "consent"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "taskType": {
      "enum": ["plant-health", "sex-identification", "pest-identification", "disease-identification", "root-health", "macro-scan", "unknown"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "plant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage"],
      "properties": {
        "plantId": { "type": "string" },
        "cultivar": { "type": "string" },
        "stage": { "type": "string", "minLength": 1 },
        "ageDays": { "type": "integer", "minimum": 0 },
        "environment": { "enum": ["indoor", "outdoor", "greenhouse", "unknown"] },
        "medium": { "type": "string" },
        "container": { "type": "string" }
      }
    },
    "evidenceMediaIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ph": { "type": "number", "minimum": 0, "maximum": 14 },
        "ecMsCm": { "type": "number", "minimum": 0 },
        "ppmScale": { "enum": ["500", "640", "700", "unknown"] },
        "temperatureC": { "type": "number", "minimum": -20, "maximum": 70 },
        "relativeHumidity": { "type": "number", "minimum": 0, "maximum": 100 },
        "ppfd": { "type": "number", "minimum": 0 },
        "co2Ppm": { "type": "number", "minimum": 0 },
        "watering": { "type": "string" },
        "recentChanges": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "userNotes": { "type": "string" }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "source", "value"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "source": { "enum": ["user", "model", "reviewer", "measurement", "laboratory"] },
          "value": { "type": ["string", "number", "boolean"] },
          "anatomicalLocation": { "type": "string" },
          "mediaId": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "score", "confidence", "supportingObservationIds", "contradictingObservationIds", "missingEvidence"],
        "properties": {
          "issueId": { "type": "string" },
          "label": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "enum": ["low", "moderate", "high"] },
          "supportingObservationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "contradictingObservationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "missingEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "modelName": { "type": "string" },
          "modelVersion": { "type": "string" },
          "rulesetVersion": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "finalLabels"],
      "properties": {
        "status": {
          "enum": ["candidate", "user-supported", "evidence-supported", "expert-verified", "lab-confirmed", "mixed-condition", "insufficient-evidence", "rejected"]
        },
        "finalLabels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "confirmationMethods": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "reviewerId": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["improved", "same", "worse", "different-condition-confirmed", "unknown"] },
        "followUpCaseId": { "type": "string" },
        "notes": { "type": "string" },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trainingAllowed", "researchAllowed", "publicCaseAllowed"],
      "properties": {
        "trainingAllowed": { "type": "boolean", "default": false },
        "researchAllowed": { "type": "boolean", "default": false },
        "publicCaseAllowed": { "type": "boolean", "default": false }
      }
    }
  }
}
