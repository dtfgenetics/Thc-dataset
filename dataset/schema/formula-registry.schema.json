{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/formula-registry-v1.json",
  "title": "THC Formula Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "formulas"
  ],
  "properties": {
    "schema_version": {
      "const": "thc-formula-registry-v1"
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "formula_id",
          "version",
          "name",
          "equation",
          "inputs",
          "output",
          "assumptions",
          "validity",
          "source_ids",
          "test_vectors",
          "consumers"
        ],
        "properties": {
          "formula_id": {
            "type": "string",
            "pattern": "^FORM-[A-Z0-9-]+$"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "equation": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "canonical_unit"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "canonical_unit": {
                  "type": "string"
                },
                "qudt_unit_iri": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "output": {
            "type": "object",
            "required": [
              "name",
              "canonical_unit"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "canonical_unit": {
                "type": "string"
              },
              "qudt_unit_iri": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validity": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "test_vectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "inputs",
                "expected",
                "tolerance"
              ],
              "properties": {
                "inputs": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "expected": {
                  "type": "number"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
