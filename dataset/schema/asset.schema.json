{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/thc-grow-doc/asset-1.0.0.json",
  "title": "THC Plant Diagnostic acquired asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","datasetId","sourceUrl","storageLane","mediaType","license","requiredAttribution","hostSpecies","hostContext","evidenceTier","confirmation","reviewStatus","trainingEligible","displayPermission","useLimitations","sha256","perceptualHash","sourceGroupId"],
  "properties": {
    "id": {"type":"string","pattern":"^ASSET-[A-Za-z0-9._-]+$"},
    "datasetId": {"type":"string","pattern":"^DS-[0-9]{3,}$"},
    "sourceFileId": {"type":"string"},
    "sourceUrl": {"type":"string","format":"uri"},
    "originalUrl": {"type":"string","format":"uri"},
    "storageLane": {"enum":["raw-open","raw-restricted","normalized","dedup","reference-only","locked-evaluation"]},
    "mediaType": {"enum":["image","video","microscopy","scan","diagram","annotation","other"]},
    "creator": {"type":"string"},
    "rightsHolder": {"type":"string"},
    "license": {"type":"string","minLength":1},
    "requiredAttribution": {"type":"string"},
    "hostSpecies": {"type":"string","minLength":1},
    "hostContext": {"enum":["cannabis","hemp","non-cannabis","organism-only","unknown"]},
    "issueIds": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "organ": {"type":"string"},
    "view": {"type":"string"},
    "growthStage": {"type":"string"},
    "severity": {"type":"string"},
    "cultivar": {"type":"string"},
    "environment": {"type":"string"},
    "evidenceTier": {"enum":["tier-0","tier-1","tier-2","tier-3","tier-4"]},
    "confirmation": {"enum":["unverified","visual","expert-reviewed","measured-exposure","lab-confirmed","illustrative"]},
    "reviewStatus": {"enum":["candidate","license-review","scientific-review","approved-reference","approved-training","locked-evaluation","rejected"]},
    "trainingEligible": {"type":"boolean"},
    "datasetSplit": {"enum":["train","validation","test","locked-evaluation","none"]},
    "sourceGroupId": {"type":"string","minLength":1},
    "plantId": {"type":"string"},
    "sessionId": {"type":"string"},
    "parentAssetId": {"type":"string"},
    "augmentationOf": {"type":"string"},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "perceptualHash": {"type":"string","minLength":8},
    "width": {"type":"integer","minimum":1},
    "height": {"type":"integer","minimum":1},
    "durationSeconds": {"type":"number","minimum":0},
    "displayPermission": {"enum":["permitted","not-permitted","unknown"]},
    "useLimitations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}
  },
  "allOf": [
    {"if":{"properties":{"trainingEligible":{"const":true}},"required":["trainingEligible"]},"then":{"required":["datasetSplit"],"properties":{"datasetSplit":{"enum":["train","validation","test"]}}}},
    {"if":{"properties":{"reviewStatus":{"const":"locked-evaluation"}}},"then":{"required":["datasetSplit"],"properties":{"trainingEligible":{"const":false},"datasetSplit":{"const":"locked-evaluation"}}}}
  ]
}
