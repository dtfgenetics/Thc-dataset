{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schema/research-study.schema.json",
  "title": "THC research study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id",
    "source_ids",
    "title",
    "study_design",
    "cannabis_scope",
    "human_subject_data",
    "participant_level_data_in_repo",
    "causal_inference_allowed",
    "population_or_specimen",
    "outcomes",
    "limitations"
  ],
  "properties": {
    "study_id": {
      "type": "string",
      "pattern": "^STUDY-[A-Z0-9-]+$"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "investigators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objective": {
      "type": "string"
    },
    "study_design": {
      "enum": [
        "randomized_controlled",
        "controlled_nonrandomized",
        "longitudinal_observational",
        "cross_sectional_observational",
        "survey",
        "case_series",
        "analytical_method",
        "project_protocol",
        "other"
      ]
    },
    "cannabis_scope": {
      "enum": [
        "cannabis",
        "transferable_non_cannabis",
        "general_method",
        "mixed"
      ]
    },
    "human_subject_data": {
      "type": "boolean"
    },
    "participant_level_data_in_repo": {
      "type": "boolean"
    },
    "direct_identifiers_present": {
      "type": "boolean"
    },
    "causal_inference_allowed": {
      "type": "boolean"
    },
    "population_or_specimen": {
      "type": "string",
      "minLength": 2
    },
    "sample_size": {
      "type": "integer",
      "minimum": 0
    },
    "repeated_measures": {
      "type": "boolean"
    },
    "observation_schedule": {
      "type": "string"
    },
    "exposures_or_interventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ethics": {
      "type": "string"
    },
    "data_availability": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
