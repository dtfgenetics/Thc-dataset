{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/thc-grow-doc/sex-observation-1.0.0.json",
  "title": "THC Grow Doc reproductive sex-expression observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "caseId", "observedAt", "classification", "evidenceMediaIds", "nodeObservations", "verificationStatus"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "caseId": { "type": "string", "minLength": 1 },
    "plantId": { "type": "string" },
    "observedAt": { "type": "string", "format": "date-time" },
    "plantAgeDays": { "type": "integer", "minimum": 0 },
    "growthStage": { "type": "string" },
    "classification": {
      "enum": ["too-early", "probable-pistillate", "confirmed-pistillate", "probable-staminate", "confirmed-staminate", "possible-co-sexual", "confirmed-co-sexual", "unusable"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidenceMediaIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "nodeObservations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeLabel", "structure"],
        "properties": {
          "nodeLabel": { "type": "string", "minLength": 1 },
          "mediaId": { "type": "string" },
          "structure": {
            "enum": ["no-visible-reproductive-structure", "pistillate-preflower", "staminate-preflower", "pollen-sac", "anther", "mixed-reproductive-structures", "ambiguous"]
          },
          "notes": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "verificationStatus": {
      "enum": ["candidate", "later-development-supported", "expert-verified", "directly-confirmed", "rejected", "insufficient-evidence"]
    },
    "laterConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": ["confirmed-pistillate", "confirmed-staminate", "confirmed-co-sexual"]
        },
        "confirmationCaseId": { "type": "string" },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "confirmationMethod": { "type": "string" }
      }
    },
    "reviewerId": { "type": "string" },
    "notes": { "type": "string" }
  }
}
