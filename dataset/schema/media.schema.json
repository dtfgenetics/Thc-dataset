{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/thc-grow-doc/media-1.1.0.json",
  "title": "THC Grow Doc media record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "issueId", "originalUrl", "thumbnailUrl", "sourceUrl", "creator", "license", "requiredAttribution", "hostSpecies", "hostContext", "useLimitations", "view", "confirmation", "reviewStatus", "trainingEligible", "sha256", "perceptualHash"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "issueId": { "type": "string" },
    "originalUrl": { "type": "string", "format": "uri" },
    "thumbnailUrl": { "type": "string", "format": "uri" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "creator": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "requiredAttribution": { "type": "string" },
    "hostSpecies": { "type": "string", "minLength": 1 },
    "hostContext": { "enum": ["cannabis", "non-cannabis", "organism-only"] },
    "useLimitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "organ": { "type": "string" },
    "view": { "enum": ["whole-plant", "close-up", "underside", "root-crown", "microscope", "diagram"] },
    "growthStage": { "type": "string" },
    "severity": { "type": "string" },
    "cultivar": { "type": "string" },
    "environment": { "type": "string" },
    "magnification": { "type": "string" },
    "confirmation": { "enum": ["visual", "expert-reviewed", "lab-confirmed", "illustrative"] },
    "reviewStatus": { "enum": ["candidate", "license-review", "scientific-review", "approved-reference", "approved-training", "rejected"] },
    "trainingEligible": { "type": "boolean" },
    "datasetSplit": { "enum": ["train", "validation", "test", "locked-evaluation", "none"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "perceptualHash": { "type": "string", "minLength": 8 }
  },
  "allOf": [
    {
      "if": { "properties": { "trainingEligible": { "const": true } }, "required": ["trainingEligible"] },
      "then": { "required": ["datasetSplit"], "properties": { "datasetSplit": { "enum": ["train", "validation", "test", "locked-evaluation"] } } }
    }
  ]
}
