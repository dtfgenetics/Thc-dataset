{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/growdoc-sft-record.schema.json",
  "title": "Grow Doc SFT record",
  "type": "object",
  "required": ["id", "lane", "messages", "provenance", "evidenceTier", "splitGroup"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "lane": {"enum": ["science_explanation", "cultivation_qa", "diagnostic_reasoning", "grounded_qa", "misconception_correction", "recordkeeping"]},
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profileId", "sourceTitle"],
        "properties": {
          "profileId": {"type": "string"},
          "sourceTitle": {"type": "string"},
          "doi": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "supportedClaims": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidenceTier": {"enum": ["A", "B", "C", "reference_only"]},
    "splitGroup": {"type": "string", "minLength": 1},
    "reviewStatus": {"enum": ["generated_unreviewed", "reviewed", "locked_eval"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
