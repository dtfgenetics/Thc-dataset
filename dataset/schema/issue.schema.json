{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtfseeds.com/schemas/thc-grow-doc/issue-1.3.0.json",
  "title": "THC Grow Doc issue record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "name", "category", "severity", "reviewStatus", "summary", "affectedParts", "stages", "indicators", "exclusions", "progression", "lookAlikes", "confirmation", "immediateActions", "correctivePlan", "prevention", "warnings", "sources", "media"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 3 },
    "scientificName": { "type": "string" },
    "canonicalId": { "type": "string", "pattern": "^CAN-[A-Z]+-[0-9]{3}$" },
    "canonicalLabel": { "type": "string", "minLength": 2 },
    "evidenceIds": { "$ref": "#/$defs/idArray" },
    "interventionEvidenceIds": { "$ref": "#/$defs/idArray" },
    "responsePolicyId": { "type": "string", "pattern": "^POL-[A-Z0-9-]+$" },
    "photoOnlyMaxConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "category": {
      "enum": ["Nutrient deficiency", "Nutrient toxicity", "Insect", "Mite", "Fungal pathogen", "Oomycete pathogen", "Bacterial pathogen", "Root pathogen", "Viroid", "Virus", "Phytoplasma / Spiroplasma", "Genetic / developmental", "Environmental stress", "Water / root-zone", "Normal development", "Insufficient evidence"]
    },
    "severity": { "enum": ["low", "moderate", "high", "critical"] },
    "reviewStatus": { "enum": ["reviewed", "provisional", "incomplete"] },
    "summary": { "type": "string", "minLength": 20 },
    "affectedParts": { "$ref": "#/$defs/stringArray" },
    "stages": { "$ref": "#/$defs/stringArray" },
    "indicators": { "$ref": "#/$defs/stringArray" },
    "exclusions": { "$ref": "#/$defs/stringArray" },
    "progression": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "description"],
        "properties": { "stage": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "lookAlikes": { "$ref": "#/$defs/stringArray" },
    "confirmation": { "$ref": "#/$defs/stringArray" },
    "immediateActions": { "$ref": "#/$defs/stringArray" },
    "correctivePlan": { "$ref": "#/$defs/stringArray" },
    "prevention": { "$ref": "#/$defs/stringArray" },
    "warnings": { "$ref": "#/$defs/stringArray" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRecord" }
    },
    "media": {
      "type": "array",
      "items": { "$ref": "#/$defs/mediaRecord" }
    }
  },
  "$defs": {
    "stringArray": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "optionalStringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "idArray": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "organization", "url", "accessedDate", "supportedClaims"],
      "properties": {
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
        "authors": { "$ref": "#/$defs/optionalStringArray" },
        "publisher": { "type": "string", "minLength": 1 },
        "publicationDate": { "type": "string", "format": "date" },
        "accessedDate": { "type": "string", "format": "date" },
        "doi": { "type": "string", "minLength": 3 },
        "supportedClaims": { "$ref": "#/$defs/stringArray" }
      }
    },
    "mediaRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alt", "caption", "mediaType", "requiredAttribution", "diagnosticLabel", "hostSpecies", "hostContext", "useLimitations", "displayPermission", "reviewStatus", "trainingPermission", "view", "confirmation", "trainingEligible"],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "format": "uri" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "creator": { "type": "string" },
        "license": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "mediaType": { "enum": ["image", "video"] },
        "requiredAttribution": { "type": "string" },
        "diagnosticLabel": { "type": "string" },
        "hostSpecies": { "type": "string" },
        "hostContext": { "enum": ["cannabis", "non-cannabis", "organism-only"] },
        "useLimitations": { "$ref": "#/$defs/optionalStringArray" },
        "displayPermission": { "enum": ["permitted", "not-permitted", "unknown"] },
        "reviewStatus": { "enum": ["candidate", "license-review", "scientific-review", "approved-reference", "approved-training", "rejected"] },
        "trainingPermission": { "enum": ["permitted", "not-permitted", "unknown"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "perceptualHash": { "type": "string", "pattern": "^dhash64:[a-f0-9]{16}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "view": { "enum": ["whole-plant", "close-up", "underside", "root-crown", "microscope", "diagram"] },
        "stage": { "type": "string" },
        "severity": { "type": "string" },
        "confirmation": { "enum": ["visual", "expert-reviewed", "lab-confirmed", "illustrative"] },
        "trainingEligible": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["url"] },
        { "required": ["thumbnailUrl"] }
      ]
    }
  }
}
