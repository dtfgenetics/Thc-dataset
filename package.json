{
  "name": "thc-grow-doc",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "validate:sources": "node scripts/validate-source-snapshot.mjs dataset/registry/sources-132-146.json dataset/registry/sources-147-158.json dataset/registry/sources-159-160.json",
    "validate:acquisition": "node scripts/validate-acquisition-snapshot.mjs dataset/acquisition/phase0-ds133-ds148.json dataset/acquisition/phase0-ds133-ds134-v2.json dataset/acquisition/phase0-ds135-v2.json dataset/acquisition/phase0-ds135-v3.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
