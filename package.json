{
  "name": "thc-grow-doc",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/publish-reference-media.mjs",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "export:data": "node scripts/export-machine-data.mjs",
    "validate:data-release": "node scripts/validate-data-release.mjs",
    "validate:diagnostic-profiles": "node scripts/audit-diagnostic-profile-quality.mjs",
    "validate:crop-geometry": "node scripts/validate-reference-crop-geometry.mjs",
    "validate:release-metadata": "node scripts/validate-release-metadata.mjs",
    "validate:sources": "node scripts/validate-source-snapshot.mjs dataset/registry/sources-132-146.json dataset/registry/sources-147-158.json dataset/registry/sources-159-160.json dataset/registry/sources-161-165.json",
    "validate:acquisition": "node scripts/validate-acquisition-snapshot.mjs dataset/acquisition/phase0-ds133-ds148.json dataset/acquisition/phase0-ds133-ds134-v2.json dataset/acquisition/phase0-ds135-v2.json dataset/acquisition/phase0-ds135-v3.json dataset/acquisition/phase0-ds135-v4.json dataset/acquisition/phase0-ds071-ds090-v1.json dataset/acquisition/phase0-ds137-ds146-v2.json dataset/acquisition/phase0-ds159-ds165-v1.json dataset/acquisition/phase0-ds135-v5.json",
    "validate:transfer": "node scripts/validate-transfer-policy.mjs dataset/acquisition/cross-crop-transfer-policy-ds137-ds146.json",
    "validate:model-eval": "python3 scripts/validate-model-eval.py model_tuning/eval/heldout_v1.jsonl && python3 scripts/validate-model-eval.py model_tuning/eval/heldout_v2.jsonl && python3 scripts/validate-model-eval.py model_tuning/eval/heldout_v3.jsonl && python3 scripts/validate-model-eval.py --self-test",
    "validate:model-base-candidates": "python3 scripts/validate-base-model-candidates.py && python3 scripts/validate-base-model-candidates.py --self-test",
    "validate:model-eval-candidates": "python3 scripts/validate-model-eval-candidates.py model_tuning/eval/candidates/pathogen_expansion_v1.manifest.json model_tuning/eval/candidates/heldout_v3_expansion_v1.manifest.json && python3 scripts/validate-model-eval-claim-bindings.py model_tuning/eval/candidates/pathogen_expansion_v1.manifest.json model_tuning/eval/candidates/heldout_v3_expansion_v1.manifest.json && python3 scripts/validate-model-eval-claim-bindings.py --self-test",
    "validate:model-eval-candidate-leakage": "python3 scripts/audit-model-eval-candidate-leakage.py && python3 scripts/audit-model-eval-candidate-leakage.py --self-test",
    "validate:model-eval-gap-research": "python3 scripts/validate-heldout-v3-gap-source-research.py",
    "validate:model-eval-coverage": "python3 scripts/audit-model-eval-coverage.py model_tuning/eval/heldout_v1.jsonl && python3 scripts/audit-model-eval-coverage.py model_tuning/eval/heldout_v2.jsonl && python3 scripts/audit-model-eval-coverage.py model_tuning/eval/heldout_v3.jsonl --require-replicated-slices && python3 scripts/audit-model-eval-coverage.py --self-test",
    "validate:model-corpus-quality": "python3 scripts/audit-model-corpus-quality.py && python3 scripts/audit-model-corpus-quality.py --self-test",
    "validate:model-source-evidence-quality": "python3 scripts/audit-model-source-evidence-quality.py && python3 scripts/audit-model-source-evidence-quality.py --self-test",
    "validate:model-example-evidence-tiers": "python3 scripts/audit-model-example-evidence-tiers.py && python3 scripts/audit-model-example-evidence-tiers.py --self-test",
    "validate:model-semantic-leakage": "python3 scripts/audit-model-semantic-leakage.py && python3 scripts/audit-model-semantic-leakage.py --self-test",
    "validate:model-corpus": "python3 scripts/build-model-corpus.py --check-only",
    "validate:grounded-qa": "python3 scripts/build-grounded-qa.py --check-only && python3 scripts/build-grounded-qa.py --self-test",
    "validate:model-split": "python3 scripts/split-model-sft.py --check-only && python3 scripts/split-model-sft.py --self-test",
    "validate:model-grounding": "python3 scripts/enforce-supplied-claim-grounding.py --self-test && python3 scripts/split-model-training-grounded.py --self-test && python3 scripts/split-model-training-grounded.py --check-only",
    "validate:training-dataset-manifest": "python3 scripts/build-training-dataset-manifest.py --self-test",
    "validate:model-scorer": "python3 scripts/score-model-eval.py --self-test",
    "validate:model-run-manifest": "python3 scripts/validate-model-run-manifest.py --self-test && python3 scripts/validate-adapter-training-provenance.py --self-test",
    "validate:model-runner": "python3 scripts/run-model-eval.py --self-test && python3 scripts/run-provenance-bound-adapter-eval.py --self-test",
    "validate:base-vs-rag-launcher": "python3 scripts/run-base-vs-rag-experiment.py --self-test",
    "validate:rag-snapshot": "python3 scripts/build-rag-eval-snapshot.py --self-test",
    "validate:qlora-config": "python3 scripts/validate-qlora-config.py && python3 scripts/validate-qlora-config.py --self-test && python3 scripts/validate-qlora-optimization-scalars.py && python3 scripts/validate-qlora-optimization-scalars.py --self-test",
    "validate:qlora-dependencies": "python3 scripts/verify-qlora-dependency-contract.py && python3 scripts/verify-qlora-dependency-contract.py --self-test",
    "validate:qlora-trainer": "python3 scripts/train-grow-doc-qlora.py --self-test",
    "validate:model-improvement-planner": "python3 scripts/plan-grow-doc-improvements.py --self-test",
    "validate:portable-rag-eval": "python3 scripts/export-portable-rag-eval.py --self-test",
    "status:grow-doc": "python3 scripts/grow-doc-contribution.py",
    "validate:grow-doc-contributions": "python3 scripts/grow-doc-contribution.py --self-test && python3 scripts/generate-grow-doc-receipt.py --self-test && python3 scripts/grow-doc-contribution.py --validate-receipts-dir contributions/receipts && npm run validate:grow-doc-receipt-history",
    "validate:grow-doc-claims": "python3 scripts/grow-doc-contribution.py --validate-claims",
    "route:grow-doc": "python3 scripts/grow-doc-contribution.py --route-manifest",
    "validate:source-intake": "python3 scripts/intake-grow-doc-sources.py --self-test",
    "validate:claim-relationships": "python3 scripts/validate-claim-relationships.py && python3 scripts/validate-claim-relationships.py --self-test",
    "validate:external-source-registries": "python3 scripts/validate-cornell-bioinformatics-registry.py && python3 scripts/validate-pubchem-chemistry-registry.py && python3 scripts/validate-plant-phenotyping-source-registry.py",
    "validate:pubchem-collector": "python3 scripts/collect-pubchem-compound.py --self-test",
    "validate:bioinformatics-contracts": "python3 scripts/validate-cornell-bioinformatics-registry.py && python3 scripts/validate-pubchem-chemistry-registry.py && python3 scripts/validate-plant-phenotyping-source-registry.py && python3 scripts/collect-pubchem-compound.py --self-test && python3 scripts/normalize-usda-grin-germplasm.py --self-test && python3 scripts/export-brapi-germplasm.py --self-test && python3 scripts/test-grin-to-brapi-contract.py && python3 scripts/resolve-trait-ontology-units.py --self-test && python3 scripts/normalize-phenotype-observations.py --self-test && python3 scripts/build-tool-source-catalog.py --self-test && python3 scripts/build-chemistry-catalog.py --self-test && python3 scripts/validate-tool-data-bundle.py --self-test",
    "build:chemistry-catalog": "python3 scripts/build-chemistry-catalog.py --registry dataset/sources/pubchem_chemistry_registry_v1.json --output dataset/generated/tool_data/chemistry_catalog_v1.json",
    "validate:tool-data-bundle-production": "python3 scripts/build-tool-data-bundle.py --root . --spec dataset/tool_data_bundle_spec_v1.json --output /tmp/tool_data_bundle_v1.json && python3 scripts/validate-tool-data-bundle.py --root . --manifest /tmp/tool_data_bundle_v1.json",
    "validate:training-supervision-concentration": "python3 scripts/audit-training-supervision-concentration.py --self-test && python3 scripts/audit-training-supervision-concentration.py",
    "validate:grow-doc-task-registry": "python3 scripts/validate-grow-doc-task-registry.py --self-test && python3 scripts/validate-grow-doc-task-registry.py",
    "validate:reviewed-claim-grounded-qa": "python3 scripts/build-reviewed-claim-grounded-qa.py --self-test && python3 scripts/build-reviewed-claim-grounded-qa.py --check-only",
    "receipt:grow-doc": "python3 scripts/generate-grow-doc-receipt.py",
    "validate:grow-doc-receipt-history": "python3 scripts/validate-grow-doc-receipt-history.py --self-test && python3 scripts/validate-grow-doc-receipt-history.py",
    "validate:model-experiment-registry": "python3 scripts/validate-grow-doc-experiment-registry.py --self-test && python3 scripts/validate-grow-doc-experiment-registry.py",
    "validate:image-preprocessing": "node scripts/validate-diagnostic-image-preprocessing.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
